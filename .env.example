# ESP-NOW encryption keys + the receiver board's MAC address, for the link
# between this Bottango Impulse board and grogu's BLE receiver board.
#
# PMK_KEY / LMK_KEY must be byte-for-byte identical to the copies in
# grogu/receiver/.env. Copy this file to .env and fill in real values.
# .env is gitignored -- never commit it.

PMK_KEY=00000000000000000000000000000000
LMK_KEY=00000000000000000000000000000000

# The BLE receiver board's WiFi MAC address. Leave as zeros until you've
# flashed and run receiver/, then open its Serial monitor and look for:
# "ESP-NOW: ready  MAC=XX:XX:XX:XX:XX:XX"
RECEIVER_BOARD_MAC=000000000000
